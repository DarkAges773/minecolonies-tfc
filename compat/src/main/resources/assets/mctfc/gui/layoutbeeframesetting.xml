    <button id="slot1" pos="42 25"  size="34 17" source="minecolonies:textures/gui/builderhut/builder_button_very_small.png" color="black"/>
    <button id="slot2" pos="79 25"  size="34 17" source="minecolonies:textures/gui/builderhut/builder_button_very_small.png" color="black"/>
    <button id="slot3" pos="116 25" size="34 17" source="minecolonies:textures/gui/builderhut/builder_button_very_small.png" color="black"/>
</window>
