<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/1.20.1/src/main/resources/assets/blockui/gui/block_ui.xsd"
        size="300 210" pause="false" lightbox="true">

    <text id="title" size="300 12" pos="0 6" textalign="MIDDLE" color="white"
          label="$(com.ldtteam.structurize.gui.scan.replace.title)"/>

    <list id="rows" size="296 158" pos="2 22" childspacing="-1">
        <box size="100% 20" linewidth="1">
            <itemicon id="srcIcon" size="16 16" pos="2 2"/>
            <text id="srcName" size="95 20" pos="22 5" color="white"/>
            <text id="arrow" size="14 20" pos="118 5" color="white" label="->"/>
            <itemicon id="dstIcon" size="16 16" pos="134 2"/>
            <text id="dstName" size="60 20" pos="154 5" color="white"/>
            <buttonimage id="change" label="$(com.ldtteam.structurize.gui.scantool.select)" size="60 17" pos="232 1"
                         source="structurize:textures/gui/buildtool/button_medium.png" textcolor="black" texthovercolor="gray"/>
        </box>
    </list>

    <buttonimage id="done" label="$(gui.done)" size="60 17" pos="120 188"
                 source="structurize:textures/gui/buildtool/button_medium.png" textcolor="black" texthovercolor="gray"/>
</window>
